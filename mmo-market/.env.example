# =====================================================================
#  MMO Market - cấu hình môi trường
#  `npm run setup` sẽ copy file này thành .env và TỰ SINH bí mật ngẫu nhiên.
#  Các giá trị *_DEV_ONLY bên dưới chỉ dùng để chạy thử trên máy.
#  Khi chạy thật (production): BẮT BUỘC đổi toàn bộ bí mật (npm run gen:secrets).
# =====================================================================

NODE_ENV=development
# local | staging | production (production sẽ từ chối khởi động nếu còn bí mật dev)
APP_ENV=local
APP_NAME=MMO Market

# ---- Địa chỉ các ứng dụng ----
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
API_PORT=4000
# Địa chỉ web/admin dùng để gọi API phía server (rewrite /api -> API)
API_INTERNAL_URL=http://localhost:4000
# Địa chỉ trình duyệt kết nối realtime (Socket.IO)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---- Cơ sở dữ liệu & Redis ----
DATABASE_URL=postgresql://mmo:mmo_dev_password@localhost:5432/mmo_market?schema=public
REDIS_URL=redis://:redis_dev_password@localhost:6379

# ---- Bí mật (đổi khi chạy thật) ----
# Khoá chủ 32 byte (base64) dùng để mã hoá kho hàng số, 2FA, số tài khoản ngân hàng.
# MẤT KHOÁ NÀY = KHÔNG GIẢI MÃ ĐƯỢC DỮ LIỆU. Hãy sao lưu an toàn.
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1jaGFuZ2UtbWUtISE=
# Bí mật HMAC xác thực webhook nạp tiền (generic HMAC)
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# API key của SePay (nếu dùng SePay). Để trống nếu không dùng.
SEPAY_API_KEY=
# Danh sách IP được gọi webhook, cách nhau dấu phẩy. Để trống = không giới hạn (chỉ nên dùng khi dev)
PAYMENT_WEBHOOK_IP_ALLOWLIST=

# ---- Cookie / phiên ----
# true khi chạy HTTPS (production). Khi true sẽ dùng tiền tố __Host- cho cookie.
COOKIE_SECURE=false
TRUST_PROXY=1

# ---- Tài khoản ngân hàng nhận tiền nạp (hiển thị trong mã VietQR) ----
DEPOSIT_BANK_BIN=970422
DEPOSIT_BANK_NAME=MB Bank
DEPOSIT_ACCOUNT_NO=0000123456789
DEPOSIT_ACCOUNT_NAME=CONG TY TNHH MMO MARKET

# ---- Email (dev dùng Mailpit: xem thư tại http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MMO Market <no-reply@mmomarket.local>

# ---- Chống bot / bảo mật ----
# Cloudflare Turnstile: để trống = tắt CAPTCHA (chỉ nên tắt khi dev)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Kiểm tra mật khẩu đã bị lộ qua HaveIBeenPwned (cần Internet)
PASSWORD_BREACH_CHECK=false
# Giới hạn IP được vào API admin, cách nhau dấu phẩy. Để trống = không giới hạn
ADMIN_IP_ALLOWLIST=

# ---- Công cụ dev (giả lập nạp tiền...). TẮT khi chạy thật ----
ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_DEV_TOOLS=true

# ---- Lưu file tải lên ----
STORAGE_DIR=./storage

# ---- Dữ liệu mẫu ----
SEED_DEMO=true
