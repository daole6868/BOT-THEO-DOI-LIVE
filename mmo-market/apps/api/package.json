{
  "name": "@mmo/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node ../../scripts/with-env.mjs node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node ../../scripts/with-env.mjs prisma migrate dev",
    "db:seed": "node ../../scripts/with-env.mjs tsx prisma/seed.ts",
    "db:reset": "node ../../scripts/with-env.mjs prisma migrate reset --force --skip-seed && npm run db:seed",
    "prisma:generate": "prisma generate",
    "test": "node ../../scripts/with-env.mjs node --import tsx --test test/*.test.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/websockets": "11.2.6",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "ioredis-mock": "8.13.1",
    "markdown-it": "14.3.2",
    "multer": "2.4.0",
    "nodemailer": "7.0.13",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.34.5",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/markdown-it": "14.2.0",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "7.0.12",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
